.buttons-row {
    flex-direction: row;
    margin: 4px;
}

.btn-action {
    flex-grow: 1;
    height: 34px;
    margin: 2px;
}

.btn-blue     { background-color: rgb(60,  130, 220); color: rgb(220, 220, 220); }
.btn-orange   { background-color: rgb(210, 130, 30);  color: rgb(220, 220, 220); }
.btn-red      { background-color: rgb(160, 50,  50);  color: rgb(220, 220, 220); }
.btn-lavender { background-color: rgb(120, 120, 200); color: rgb(220, 220, 220); }

.btn-blue:hover     { background-color: rgb(80,  155, 245); }
.btn-orange:hover   { background-color: rgb(235, 155, 50);  }
.btn-red:hover      { background-color: rgb(190, 65,  65);  }
.btn-lavender:hover { background-color: rgb(145, 145, 220); }

/* ── Mode foldouts ────────────────────────────────────────────────────────── */

.mode-foldout {
    margin: 4px;
}

/* ── Assembly group ───────────────────────────────────────────────────────── */

.assembly-foldout {
    margin: 2px 0;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.2);
    border-radius: 3px;
}

.assembly-foldout > .unity-foldout__toggle {
    background-color: rgba(0, 0, 0, 0.12);
    padding: 2px 0;
}

/* ── Table ────────────────────────────────────────────────────────────────── */

.table-header-row {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.2);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.25);
    padding: 2px 0;
}

.header-label {
    -unity-font-style: bold;
    font-size: 11px;
    padding: 0 4px;
}

.test-row {
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.08);
    min-height: 22px;
}

.test-row:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

.row-disabled {
    background-color: rgba(200, 60, 60, 0.07);
}

/* ── Columns ──────────────────────────────────────────────────────────────── */

.col-fullname {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    padding: 1px 4px;
    overflow: hidden;
}

/* strip the label area from the readonly TextField */
.col-fullname > .unity-base-field__label {
    display: none;
}

.col-fullname > .unity-base-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0 2px;
}

.col-enabled {
    width: 120px;
    flex-shrink: 0;
    padding: 0 4px;
}

.col-changed {
    width: 100px;
    flex-shrink: 0;
    padding: 0 4px;
    color: rgb(240, 90, 60);
    -unity-font-style: bold;
    font-size: 11px;
}
