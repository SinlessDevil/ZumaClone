.section-box {
    margin: 4px;
    padding: 4px;
}

/* ── Buttons ──────────────────────────────────────────────────────────────── */

.btn-tall { height: 32px; }
.btn-add  { height: 28px; margin-top: 4px; }

.btn-green { background-color: rgb(60, 160, 60); color: rgb(220, 220, 220); }
.btn-green:hover { background-color: rgb(75, 185, 75); }

.btn-red { background-color: rgb(160, 50, 50); color: rgb(220, 220, 220); margin-top: 4px; }
.btn-red:hover { background-color: rgb(190, 65, 65); }

/* ── Enum display fields ──────────────────────────────────────────────────── */

.enum-field {
    height: 72px;
    margin: 2px 0;
}

.enum-field > .unity-base-field__input {
    height: 72px;
    white-space: normal;
}

/* ── Sound item list ──────────────────────────────────────────────────────── */

.list-scroll {
    height: 400px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.25);
    border-radius: 3px;
    margin: 4px 0;
}

.sound-item {
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.15);
    margin-bottom: 1px;
    padding: 0 4px;
}

.sound-item > Foldout > .unity-foldout__toggle {
    background-color: rgba(0, 0, 0, 0.08);
}
